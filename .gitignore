# Local reference/working-prompt documents pasted into the repo root during
# interactive sessions (fix/efficiency-norm-kappa, Step 8 working prompt):
# kept local rather than committed or deleted, and ignored here specifically
# so they stop making `git status --porcelain` non-empty (every provenance
# sidecar's git_commit hash was picking up a spurious "-dirty" suffix from
# these alone, not from any actual code change).
/main.tex
/CGMY_presubmission_review_and_efficiency_fix_notes.md
/PRE_SUBMISSION_FIXES_CGMY_NEURAL_OPERATOR.md
/PROMPT_certification_fixes.md
/notes/00_code_map.md

# -----------------------------------------------------------------------------
# Do not ignore important project files
# -----------------------------------------------------------------------------
!README.md
!LICENSE
!.gitignore
!requirements.txt
!pyproject.toml
!environment.yml
!configs/
!configs/**
!scripts/
!scripts/**
!src/
!src/**
!tests/
!tests/**
!docs/
!docs/**
!paper/
!paper/**

# The blanket !src/** / !scripts/** / !tests/** negations above re-include
# everything under those trees, undoing the earlier __pycache__/ ignore for
# paths inside them -- re-ignore explicitly (must come after the negations
# to take effect; gitignore evaluates patterns in file order).
**/__pycache__/
**/*.py[cod]
